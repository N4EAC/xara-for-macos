[Unit]
Description=xara VARA-compatible modem
Documentation=man:xara(1)
After=pipewire-pulse.service pulseaudio.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=exec
StateDirectory=xara
ExecStart=/usr/bin/xara --config %E/xara/xara.conf
Restart=on-failure
RestartSec=10s
SuccessExitStatus=130
RestartPreventExitStatus=2
TimeoutStopSec=10s
NoNewPrivileges=yes

[Install]
WantedBy=default.target
